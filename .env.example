# Copiar como .env y llenar. El .env no se sube al repositorio.

# Nombres de los marcadores separados por coma. Cada nombre define sus variables PG_<NOMBRE>_*
MARCADORES=ENIGMA_CXD_1,ENIGMA_CXD_2

# ENIGMA_CXD_1 (PostgreSQL, solo lectura)
PG_ENIGMA_CXD_1_HOST=
PG_ENIGMA_CXD_1_PORT=5435
PG_ENIGMA_CXD_1_DB=ctidb
PG_ENIGMA_CXD_1_USER=
PG_ENIGMA_CXD_1_PASSWORD=

# ENIGMA_CXD_2 (PostgreSQL, solo lectura)
PG_ENIGMA_CXD_2_HOST=
PG_ENIGMA_CXD_2_PORT=5434
PG_ENIGMA_CXD_2_DB=ctidb
PG_ENIGMA_CXD_2_USER=
PG_ENIGMA_CXD_2_PASSWORD=

# Destino de las tablas de reporte
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
# 0 = no guardar histórico en MySQL (el reporte y el correo salen igual)
MYSQL_HABILITADO=1

# Opcionales
TYPECALL=CallAuto
PG_STATEMENT_TIMEOUT_MS=600000
CARPETA_SALIDA=salidas
